# Copy to .env.local for local development, and add the same two variables in
# Vercel → Project → Settings → Environment Variables.
#
# Supabase → Project Settings → API Keys:
#   URL:  https://<project-ref>.supabase.co
#   Key:  the PUBLISHABLE key (sb_publishable_...) — or the legacy "anon" key.
# NEVER use the secret / service_role key here: VITE_ variables are sent to every visitor.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Optional, only for `npm run verify:supabase` (never commit real values).
# OWNER_EMAIL=
# OWNER_PASSWORD=
